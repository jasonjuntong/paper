rules_version = '2';

// All privileged data access in this app goes through `firebase-admin`
// (server-side route handlers and server components), which bypasses these
// rules. The client SDK is used for Auth only — it never reads or writes
// Firestore directly. These rules therefore default to deny, and only open up
// the reads that a future client-side surface would legitimately need.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOrgMember(orgId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid));
    }

    // isOrgMember short-circuits on exists() before the get().data below, so
    // we never call .data on a missing member doc (which would error the rule).
    function isOrgAdmin(orgId) {
      return isOrgMember(orgId) &&
        get(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    function isPublicOrg(orgId) {
      return get(/databases/$(database)/documents/orgs/$(orgId)).data.visibility == 'public';
    }

    // Orgs. Writes are server-only (firebase-admin), which bypasses these rules;
    // the permissions table's *mutation* rules (member cap, Admin-only actions,
    // owner-only shares, visibility invariants) are enforced in the route
    // handlers, not here — so writes are denied outright and never trusted from
    // the client. Reads: public orgs are discoverable by *authenticated* users
    // (browsing is scoped to signed-in users); private orgs are member-only.
    match /orgs/{orgId} {
      allow read: if isOrgMember(orgId) || (isSignedIn() && resource.data.visibility == 'public');
      allow write: if false;

      // Public-org list access (permissions table): any authenticated user may
      // read the metadata snapshot of papers shared to a *public* org. Private
      // orgs' sharedPapers stay member-only. This exception is sharedPapers-only.
      match /sharedPapers/{paperId} {
        allow read: if isOrgMember(orgId) || (isSignedIn() && isPublicOrg(orgId));
        allow write: if false;
      }

      // The member roster is member-readable (member-listing surface).
      match /members/{memberId} {
        allow read: if isOrgMember(orgId);
        allow write: if false;
      }

      // Moderation subcollections are Admin-only — they surface to the Admin,
      // not to members. The recipient-read exception for invites/offers (the
      // targeted user reading their own doc) is deferred until ORG-016/017/010
      // finalize the recipient-uid field; today's docs carry no such field. See
      // nuance N-005.
      match /invites/{inviteId} {
        allow read: if isOrgAdmin(orgId);
        allow write: if false;
      }
      match /joinRequests/{requestId} {
        allow read: if isOrgAdmin(orgId);
        allow write: if false;
      }
      match /adminTransferOffers/{offerId} {
        allow read: if isOrgAdmin(orgId);
        allow write: if false;
      }
    }

    // Handle reservations. Deliberate exception to the "client never reads
    // Firestore" rule above: the registration form reads this collection
    // (before the user is signed in) to give live "handle available?" feedback.
    // Handles are public by design, so reads are open. Writes (reserve on
    // registration, tombstone on deletion) stay server-only via firebase-admin.
    match /handles/{handle} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else is server-managed via firebase-admin. Deny all direct
    // client access by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
